# Trendora E-Commerce Environment Configuration (Template)
# Copy this file to .env and configure your local/testing values.
# Do NOT commit production credentials or secrets to version control.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/trendora
JWT_SECRET=your_jwt_secret_key_here

# Allowed frontend origin for CORS in production (e.g. https://your-trendora-store.vercel.app)
# Leave empty or set to * for local development
CLIENT_URL=http://localhost:3000

# Razorpay Test Mode Credentials
# Obtain test credentials from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
